generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Invitee {
  id                          Int       @id @default(autoincrement())
  name                        String    @unique
  isAttending                 Boolean?  
  household                   Household @relation(fields: [householdId], references: [id])
  householdId                 Int
}

model Household {
  id                          Int       @id @default(autoincrement())
  name                        String    @unique
  hasRSVPed                   Boolean   @default(false)
  hasDietaryRestrictions      Boolean?  
  dietaryRestrictions         String?   
  notes                       String?   
  updatedAt                   DateTime  @updatedAt
  children12                  Int       @default(0)
  children3                   Int       @default(0)
  invitees                    Invitee[] 
}